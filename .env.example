# Set these in your shell. This file is not loaded implicitly.
# Default Milvus URI is .storage/incidents.db (actual Milvus Lite).
# MILVUS_URI=http://127.0.0.1:19530
# AIOPS_KUBECTL=C:\path\to\kubectl.exe
# AIOPS_KUBECONFIG=C:\path\to\dedicated-kubeconfig.json
AIOPS_KUBE_CONTEXT=aiops-demo
AIOPS_KUBE_NAMESPACE=aiops-demo
# Default prevents online mutations. Explicitly enable only for an authorized demo namespace.
AIOPS_ALLOW_RESTARTS=0
# GITHUB_TOKEN may be supplied in the environment; never put a real token in this example.
